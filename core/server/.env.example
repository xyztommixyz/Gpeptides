# Öffentliche Adresse des Shops (für die Links in den E-Mails)
BASE_URL=https://example.com

# SMTP-Zugang (z. B. von eurem Mail-Provider, Brevo, Postmark, Mailjet, Amazon SES …)
# Ohne SMTP_HOST läuft der Server im Dev-Modus und gibt die Links nur in der Konsole aus.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SSL=0
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me
# Absender; Standard aus site/site.json ("mailFrom" bzw. Name <no-reply@domain>)
# MAIL_FROM=Shop <no-reply@example.com>

# Optional
# SITE_DIR=/srv/SHOP/site   (Standard: ../../site neben core/server)
# DB_PATH=/var/lib/SHOP/SHOP.db   (Standard: <site.json id>.db neben app.py)
# PORT=8000

# ---- Kasse ----
# Versandkosten in EUR (Beispielwerte, nur Startwerte: im Admin unter „Preise & Versand“ änderbar, dann gilt der Admin-Wert)
SHIPPING_DE=4.90
SHIPPING_EU=9.90
# Ab diesem Warenwert (nach Rabatt, ohne Versand) versandkostenfrei (0 = aus)
FREE_SHIPPING_FROM=100
# Bankverbindung für Vorkasse (steht in der Bestellbestätigung)
BANK_OWNER=Shop
BANK_IBAN=DE00 0000 0000 0000 0000 00
BANK_BIC=XXXXXXXX
BANK_NAME=Eure Bank
# Optional: Online-Zahlung über Stripe Checkout (Karte, PayPal, Klarna … je nach Stripe-Konto)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (Webhook-URL: https://example.com/api/stripe/webhook, Event: checkout.session.completed)
# Postfach, das bei jeder Bestellung benachrichtigt wird
# ORDER_NOTIFY=bestellungen@example.com

# ---- Rechnungen (Pflichtangaben, bitte ausfüllen) ----
SHOP_LEGAL_NAME=Shop [Rechtsform]
# Adresse, Zeilen mit | trennen
SHOP_ADDRESS=Musterstraße 1|12345 Musterstadt|Deutschland
SHOP_EMAIL=info@example.com
# USt-IdNr. und/oder Steuernummer
SHOP_VAT_ID=
SHOP_TAX_NO=
VAT_RATE=19
# Kleinunternehmer nach § 19 UStG (keine Umsatzsteuer auf der Rechnung): 1
SMALL_BUSINESS=0
# Link zur Sendungsverfolgung, {code} wird ersetzt
# TRACKING_URL=https://www.dhl.de/de/privatkunden/pakete-empfangen/verfolgen.html?piececode={code}

# ---- Expressversand (Aufpreis in EUR, 0 = nicht angeboten; Startwert, im Admin änderbar) ----
EXPRESS_DE=9.90
EXPRESS_EU=0

# ---- Bestand und Datensicherung ----
STOCK_LOW=5
# BACKUP_DIR=/srv/SHOP/core/server/backups
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14

# ---- Affiliate-Codes ----
# Rabatt für Kunden und Provision für Partner in Prozent
AFFILIATE_DISCOUNT=10
AFFILIATE_COMMISSION=10
# Codes beim Start anlegen (optional, sonst per Befehl: python app.py add-affiliate CODE "Name")
# AFFILIATE_CODES=ANNA10:Anna,LABOR10:Labor Müller
# Zugang für die Admin-Schnittstelle (/api/admin/...) – langes, zufälliges Passwort wählen.
# Kennt keine 2FA und ist deshalb abgeschaltet, solange ADMIN_2FA_REQUIRED gilt.
# ADMIN_TOKEN=
# Zwei-Faktor-Anmeldung für alle Admin-Zugänge Pflicht. Standard: an, sobald BASE_URL mit https:// beginnt.
# Zugänge ohne 2FA sehen nach der Anmeldung nur die Einrichtung (Authenticator-App). Handy verloren: python app.py reset-2fa NAME
# ADMIN_2FA_REQUIRED=1
# Team-Ansicht im Kundenkonto (ADMIN_EMAILS bzw. Admin-E-Mail): nur neue Codes, Rabatt und Provision höchstens so viel Prozent.
# Bestehende Codes ändern und höhere Werte gehen nur im Admin-Bereich.
# TEAM_MAX_PCT=20
# Shop-E-Mails, die im Kundenkonto alle Partner-Codes sehen und neue anlegen dürfen (kommagetrennt).
# Alternativ trägt jeder Admin seine E-Mail selbst im Admin-Bereich unter "Zugang" ein.
# ADMIN_EMAILS=anna@example.com,ben@example.com

# ---- Cases (Partner-Fulfillment, nur wenn site.json features.cases an ist) ----
# Startwert der Provision für den Shop in % vom Case-Warenwert (danach im Admin-Bereich änderbar)
NEXO_COMMISSION=15
# Postfach des Case-Partners für neue und bezahlte Case-Bestellungen (kommagetrennt; zusätzlich zur E-Mail im Partner-Zugang)
# NEXO_NOTIFY=bestellungen@partner.example
# Anschrift des Case-Partners für die Gutschrift (Zeilen mit | trennen)
# NEXO_ADDRESS=Partner GmbH|Straße 1|12345 Ort
