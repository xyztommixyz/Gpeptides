# systemd-Dienst: startet den Shop beim Hochfahren und nach Abstürzen neu.
# Kopieren nach /etc/systemd/system/gpeptides.service, dann:
#   sudo systemctl daemon-reload && sudo systemctl enable --now gpeptides
[Unit]
Description=GPeptides Shop
After=network.target

[Service]
User=gpeptides
WorkingDirectory=/srv/gpeptides/core/server
EnvironmentFile=/srv/gpeptides/core/server/.env
ExecStart=/srv/gpeptides/venv/bin/gunicorn -w 3 -b 127.0.0.1:8000 --access-logfile - app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
