# Caddy (einfachste Variante): holt das HTTPS-Zertifikat automatisch, komprimiert mit Brotli/gzip und liefert
# Bilder, Schriften und Produktbilder direkt aus, ohne den Python-Server zu belasten.
# Installation: https://caddyserver.com/docs/install  ·  Pfade unten an euren Server anpassen.

gpeptides.net, www.gpeptides.net {
	encode zstd gzip

	# statische Dateien direkt von der Platte (lange im Browser-Cache)
	@static path /fonts/* /favicon.ico
	handle @static {
		root * /srv/gpeptides/core/public
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# Produktbilder des Projekts
	@thumbs path /thumbs/*
	handle @thumbs {
		root * /srv/gpeptides/site
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# alles andere (Seiten, API, Admin, /assets/) an den Python-Server
	handle {
		reverse_proxy 127.0.0.1:8000
	}

	header {
		-Server
	}
}
