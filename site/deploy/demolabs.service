# systemd-Dienst: startet den Shop beim Hochfahren und nach Abstürzen neu.
# Kopieren nach /etc/systemd/system/demolabs.service, dann:
#   sudo systemctl daemon-reload && sudo systemctl enable --now demolabs
[Unit]
Description=Shop
After=network.target

[Service]
User=demolabs
WorkingDirectory=/srv/demolabs/core/server
EnvironmentFile=/srv/demolabs/core/server/.env
ExecStart=/srv/demolabs/venv/bin/gunicorn -w 3 -b 127.0.0.1:8000 --access-logfile - app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
